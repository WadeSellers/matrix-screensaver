<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for App Store distribution. Restricts file system,
	     network, and inter-process access unless explicitly entitled. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- StoreKit 2 needs outbound network access to reach Apple's
	     servers for product metadata and purchase verification. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
